{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "esModuleInterop": true, "strict": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "electron.vite.config.ts", "tests/**/*.ts", "playwright.config.ts"]
}
